{
  "name": "veritahealth",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted smartphone screening for cardiac arrest and stroke (FAST), using only sensors already on the phone.",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
